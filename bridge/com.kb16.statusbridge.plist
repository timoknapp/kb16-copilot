<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS LaunchAgent to keep the KB16 status bridge running in the background.
  Install:
    1. Create the venv (Apple's python3 cannot load hidapi - see requirements.txt):
         /opt/homebrew/bin/python3.13 -m venv ~/.venvs/kb16-bridge
         ~/.venvs/kb16-bridge/bin/pip install -r bridge/requirements.txt
    2. Edit the /Users/YOU paths below to your home directory.
    3. cp com.kb16.statusbridge.plist ~/Library/LaunchAgents/
    4. launchctl load ~/Library/LaunchAgents/com.kb16.statusbridge.plist
  Stop:
    launchctl unload ~/Library/LaunchAgents/com.kb16.statusbridge.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kb16.statusbridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOU/kb16-copilot/bridge/kb16-status-bridge</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Without this, Python block-buffers stdout when it is not a tty and the
         log files stay empty, making the agent impossible to diagnose. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/YOU/Library/Logs/kb16-statusbridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Library/Logs/kb16-statusbridge.err.log</string>
</dict>
</plist>
